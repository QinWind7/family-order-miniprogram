.requester-page {
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}

.r-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 16rpx 4rpx 28rpx;
}

.hello-title {
  font-size: 40rpx;
  font-weight: 700;
}

.hello-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9A9187;
}

.my-orders-link {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #FFEDE7;
  color: #D9462C;
  font-size: 24rpx;
}

.cats {
  white-space: nowrap;
  margin: 0 -28rpx 14rpx;
  padding: 10rpx 0;
  box-sizing: content-box;
}

.cat {
  display: inline-block;
  margin-left: 20rpx;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #7C7368;
  font-size: 26rpx;
  box-shadow: 0 6rpx 16rpx rgba(96, 63, 28, 0.05);
}

.cat:first-child {
  margin-left: 28rpx;
}

.cat.active {
  background: #2D2A26;
  color: #FFF7EE;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.dish-card {
  width: calc(50% - 10rpx);
  margin-bottom: 22rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #FFFFFF;
  box-shadow: 0 10rpx 28rpx rgba(96, 63, 28, 0.06);
}

.thumb {
  position: relative;
  height: 216rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.thumb-img {
  width: 100%;
  height: 100%;
}

.thumb-char {
  font-size: 66rpx;
  font-weight: 600;
  color: rgba(92, 60, 28, 0.55);
}

.soldout {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 250, 243, 0.66);
  color: #8C8378;
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.dish-body {
  padding: 20rpx 22rpx 22rpx;
}

.dish-name {
  font-size: 29rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.dish-note {
  min-height: 34rpx;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #A79E92;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.dish-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.dish-cat {
  font-size: 21rpx;
  color: #B4A897;
}

.off-text {
  font-size: 22rpx;
  color: #BDB2A2;
}

.cart-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 112rpx;
  padding: 0 16rpx 0 42rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #2D2A26;
  color: #FFFFFF;
  box-shadow: 0 16rpx 40rpx rgba(45, 42, 38, 0.28);
}

.cart-main {
  font-size: 28rpx;
}

.cart-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFB36B;
}

.cart-sub {
  margin-top: 2rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.5);
}

.cart-go {
  height: 82rpx;
  line-height: 82rpx;
  padding: 0 46rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FF9A4D, #F5583B);
  font-size: 30rpx;
  font-weight: 600;
}

.cart-go.is-disabled {
  opacity: 0.45;
}
