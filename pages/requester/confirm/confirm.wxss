.tip-card {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  font-size: 24rpx;
  color: #8A7B69;
  background: #FFF8EC;
}

.list {
  padding: 6rpx 26rpx;
}

.row-line {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #F6F0E7;
}

.row-line:last-child {
  border-bottom: none;
}

.thumb-xs {
  width: 92rpx;
  height: 92rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.thumb-xs-img {
  width: 100%;
  height: 100%;
}

.thumb-xs-char {
  font-size: 38rpx;
  font-weight: 600;
  color: rgba(92, 60, 28, 0.55);
}

.row-main {
  flex: 1;
  margin-left: 22rpx;
  min-width: 0;
}

.row-name {
  font-size: 29rpx;
  font-weight: 600;
}

.row-cat {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #A79E92;
}

.remark-card {
  margin-top: 24rpx;
  padding: 26rpx;
}

.remark-title {
  font-size: 26rpx;
  color: #6F675D;
}

.remark-input {
  width: 100%;
  height: 150rpx;
  margin-top: 14rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #FAF6EF;
  font-size: 27rpx;
}

.ph {
  color: #C5BBAE;
}

.submit {
  margin-top: 40rpx;
}
