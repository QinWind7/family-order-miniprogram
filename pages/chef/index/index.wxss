.chef-page {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.chef-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 16rpx 4rpx 28rpx;
}

.hello-title {
  font-size: 40rpx;
  font-weight: 700;
}

.hello-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9A9187;
}

.switch-role {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #8A8073;
  font-size: 23rpx;
  box-shadow: 0 6rpx 16rpx rgba(96, 63, 28, 0.05);
}

.orders-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #3A332B, #55483A);
  color: #FFF6EA;
  box-shadow: 0 16rpx 34rpx rgba(62, 47, 30, 0.2);
}

.banner-left {
  display: flex;
  align-items: center;
}

.banner-icon {
  width: 74rpx;
  height: 74rpx;
  margin-right: 22rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.banner-title {
  font-size: 30rpx;
  font-weight: 600;
}

.banner-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(255, 246, 234, 0.6);
}

.banner-go {
  font-size: 24rpx;
  color: #FFC58F;
}

.list-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 40rpx 4rpx 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
}

.list-count {
  font-size: 22rpx;
  color: #A79E92;
}

.dish-row {
  display: flex;
  padding: 22rpx;
  margin-bottom: 20rpx;
}

.dish-row.is-off .thumb-sm,
.dish-row.is-off .dish-main {
  opacity: 0.55;
}

.thumb-sm {
  width: 160rpx;
  height: 160rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.thumb-sm-img {
  width: 100%;
  height: 100%;
}

.thumb-sm-char {
  font-size: 58rpx;
  font-weight: 600;
  color: rgba(92, 60, 28, 0.55);
}

.dish-main {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.dish-head {
  display: flex;
  align-items: center;
}

.dish-name {
  max-width: 300rpx;
  font-size: 32rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.dish-cat {
  margin-left: 14rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: #F7F2EA;
  color: #A18F7B;
  font-size: 20rpx;
}

.dish-note {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #A79E92;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.dish-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.switch-wrap {
  display: flex;
  align-items: center;
}

.switch-label {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: #8A8073;
}

.links {
  display: flex;
  align-items: center;
}

.link {
  margin-left: 24rpx;
  font-size: 24rpx;
  color: #8A8073;
}

.link.danger {
  color: #D9462C;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(36rpx + env(safe-area-inset-bottom));
  z-index: 20;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 42rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FF9A4D, #F5583B);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 16rpx 34rpx rgba(245, 88, 59, 0.32);
}
