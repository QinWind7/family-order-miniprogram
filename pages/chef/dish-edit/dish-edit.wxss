.form {
  padding: 8rpx 28rpx;
}

.field {
  padding: 26rpx 0;
  border-bottom: 2rpx solid #F6F0E7;
}

.field:last-child {
  border-bottom: none;
}

.field-label {
  font-size: 26rpx;
  color: #6F675D;
}

.field-input {
  height: 64rpx;
  margin-top: 10rpx;
  font-size: 30rpx;
}

.field-textarea {
  width: 100%;
  height: 140rpx;
  margin-top: 14rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #FAF6EF;
  font-size: 27rpx;
}

.ph {
  color: #C5BBAE;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.chip {
  margin: 0 14rpx 12rpx 0;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #F7F2EA;
  color: #8A8073;
  font-size: 23rpx;
}

.chip.active {
  background: #FFEDE7;
  color: #D9462C;
}

.image-picker {
  position: relative;
  margin-top: 16rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #FAF6EF;
}

.picked {
  width: 200rpx;
  height: 200rpx;
}

.pick-empty {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #C0B6A8;
}

.upload-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(45, 42, 38, 0.5);
  color: #FFFFFF;
  font-size: 22rpx;
}

.image-links {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}

.image-link {
  margin-right: 28rpx;
  font-size: 24rpx;
  color: #D9462C;
}

.pick-plus {
  font-size: 44rpx;
  line-height: 1;
}

.pick-text {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.field-hint {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #BDB2A2;
}

.switch-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.save {
  margin-top: 40rpx;
}

.delete-link {
  margin-top: 28rpx;
  text-align: center;
  font-size: 25rpx;
  color: #C05540;
}
