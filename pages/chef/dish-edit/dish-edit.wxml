<view class="page">
  <view class="form card">
    <view class="field">
      <view class="field-label">菜名</view>
      <input
        class="field-input"
        placeholder="例如：番茄炒蛋"
        placeholder-class="ph"
        value="{{form.name}}"
        maxlength="20"
        data-field="name"
        bindinput="onInput"
      />
    </view>

    <view class="field">
      <view class="field-label">分类</view>
      <input
        class="field-input"
        placeholder="例如：家常菜"
        placeholder-class="ph"
        value="{{form.category}}"
        maxlength="10"
        data-field="category"
        bindinput="onInput"
      />
      <view class="chips">
        <view
          class="chip {{form.category === item ? 'active' : ''}}"
          wx:for="{{categoryOptions}}"
          wx:key="*this"
          data-name="{{item}}"
          bindtap="onPickCategory"
        >{{item}}</view>
      </view>
    </view>

    <view class="field">
      <view class="field-label">图片</view>
      <view class="image-picker" bindtap="onChooseImage">
        <image wx:if="{{previewImage}}" class="picked" src="{{previewImage}}" mode="aspectFill"></image>
        <view wx:else class="pick-empty">
          <text class="pick-plus">＋</text>
          <text class="pick-text">上传图片</text>
        </view>
        <view wx:if="{{uploading}}" class="upload-mask">上传中…</view>
      </view>
      <view class="image-links">
        <text wx:if="{{form.image}}" class="image-link" bindtap="onRemoveImage">移除图片</text>
        <text wx:if="{{form.image}}" class="image-link" bindtap="onChooseImage">更换图片</text>
      </view>
      <view class="field-hint">图片上传至云存储，家人打开小程序即可看到</view>
    </view>

    <view class="field">
      <view class="field-label">备注</view>
      <textarea
        class="field-textarea"
        placeholder="口味偏好、做法说明（选填）"
        placeholder-class="ph"
        value="{{form.note}}"
        maxlength="60"
        data-field="note"
        bindinput="onInput"
      />
    </view>

    <view class="field switch-field">
      <view>
        <view class="field-label">今天做这道菜</view>
        <view class="field-hint">关闭后点菜人无法选择</view>
      </view>
      <switch checked="{{form.available}}" color="#F5583B" bindchange="onAvailableChange" />
    </view>
  </view>

  <view class="save btn-primary" bindtap="onSave">{{isEdit ? '保存修改' : '添加菜品'}}</view>
  <view wx:if="{{isEdit}}" class="delete-link" bindtap="onDelete">删除这道菜</view>
</view>
